APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: "log" locally. Production uses the Resend HTTP API (SMTP ports are blocked
# by the host). The MAIL_FROM_ADDRESS domain must be verified at resend.com/domains.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# SMTP fallback (set MAIL_MAILER=smtp to use). 465 -> ssl/smtps, 587 -> tls.
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_SCHEME=smtps
# MAIL_EHLO_DOMAIN=

# Google reCAPTCHA v2 (Invisible) - gates public mail-sending endpoints.
# Set RECAPTCHA_ENABLED=false locally / in CI. See docs/RECAPTCHA.md.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# In-app purchases - fill these in once the store products/credentials exist (see docs/IN_APP_PURCHASES.md)
APPSTORE_BUNDLE_ID=com.ikigaiconnect.app
APPSTORE_PASSWORD=
# Set to true ONLY on a dev/test backend to accept purchases made against a local Xcode
# StoreKit configuration file (they can't be cryptographically verified). Leave false in production.
APPSTORE_ALLOW_XCODE_ENV=false
GOOGLE_PLAY_PACKAGE_NAME=com.ikigaiconnect.app
GOOGLE_APPLICATION_CREDENTIALS=
